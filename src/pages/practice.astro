---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import rawData from "@/data/guide-app.json";

const payload = JSON.stringify(rawData).replace(/<\//g, "<\\/");
---

<Layout title="练习场 — 章节小考 · 综合大考 · 八股闪卡">
  <Header />
  <main id="main-content" class="app-layout my-1">
    <section class="border-border border-b pt-8 pb-4">
      <h1 class="my-3 inline-block text-3xl font-bold sm:my-5 sm:text-4xl">
        练习场
      </h1>
      <p>
        章节小考、综合大考与八股闪卡。学习进度保存在浏览器本地，可导出迁移；
        文章里的打卡勾选同样计入下方总进度。
      </p>
    </section>
    <nav id="pg-tabs" class="pg-tabs border-border border-b">
      <a href="#home" data-tab="home" class="active">进度</a>
      <a href="#cards" data-tab="cards">闪卡</a>
      <a href="#quiz" data-tab="quiz">选择填空</a>
      <a href="#exam" data-tab="exam">综合大考</a>
    </nav>
    <div id="pg-view" class="py-2"></div>
    <div class="pg-foot">
      <button class="pg-btn" id="pg-export">导出进度</button>
      <button class="pg-btn" id="pg-import">导入进度</button>
      <button class="pg-btn" id="pg-reset">重置</button>
    </div>
  </main>
  <script type="application/json" id="pg-data" set:html={payload} />
  <Footer />
</Layout>

<style is:global>
  /* ===== 练习场（纸感风格，复用主题配色变量） ===== */
  .pg-tabs {
    display: flex;
    gap: 1.25rem;
    padding: 0.5rem 0;
    overflow-x: auto;
  }
  .pg-tabs a {
    padding: 0.35rem 0.1rem;
    font-weight: 500;
    color: var(--foreground);
    border-bottom: 2px solid transparent;
    white-space: nowrap;
  }
  .pg-tabs a:hover {
    color: var(--accent);
  }
  .pg-tabs a.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
  .pg-foot {
    display: flex;
    gap: 0.5rem;
    padding: 0.75rem 0 2rem;
    border-top: 1px solid var(--border);
    margin-top: 1.5rem;
  }
  .pg-btn {
    font-size: 0.8rem;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--background);
    color: var(--foreground);
    cursor: pointer;
  }
  .pg-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .pg-primary {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-foreground);
  }
  .pg-primary:hover {
    color: var(--accent-foreground);
    opacity: 0.88;
  }
  .pg-bar {
    height: 5px;
    background: var(--muted);
    border-radius: 99px;
    overflow: hidden;
  }
  .pg-bar i {
    display: block;
    height: 100%;
    background: var(--accent);
    border-radius: 99px;
    transition: width 0.3s;
  }
  .pg-panel {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.1rem 1.25rem;
    margin: 0.9rem 0;
    background: var(--background);
  }
  .pg-muted {
    color: var(--muted-foreground);
    font-size: 0.85rem;
  }
  .pg-row {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin: 0.55rem 0;
  }
  .pg-row .pg-name {
    width: 11rem;
    flex: none;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .pg-row .pg-bar {
    flex: 1;
    align-self: center;
  }
  .pg-row .pg-num {
    flex: none;
    width: 8.5rem;
    text-align: end;
    font-size: 0.78rem;
    color: var(--muted-foreground);
  }
  .pg-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0.8rem 0;
  }
  .pg-chip {
    border: 1px solid var(--border);
    border-radius: 99px;
    padding: 0.18rem 0.7rem;
    font-size: 0.78rem;
    cursor: pointer;
    background: var(--background);
    color: var(--foreground);
  }
  .pg-chip.on {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-foreground);
  }
  .pg-select {
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--background);
    color: var(--foreground);
    font-size: 0.82rem;
  }
  .pg-q {
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.75;
  }
  .pg-opt {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.6rem 0.85rem;
    margin: 0.5rem 0;
    cursor: pointer;
    font-size: 0.92rem;
    line-height: 1.7;
  }
  .pg-opt:hover {
    border-color: var(--accent);
  }
  .pg-opt b {
    color: var(--accent);
    flex: none;
  }
  .pg-opt.right {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, var(--background));
  }
  .pg-opt.wrong {
    border-color: #ef4444;
    background: color-mix(in srgb, #ef4444 7%, var(--background));
  }
  .pg-blank {
    border: none;
    border-bottom: 2px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 6%, var(--background));
    padding: 0.15rem 0.6rem;
    border-radius: 6px 6px 0 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--foreground);
    outline: none;
    margin: 0 0.25rem;
    min-width: 7rem;
    text-align: center;
  }
  .pg-blank.ok {
    border-color: #16a34a;
  }
  .pg-blank.bad {
    border-color: #ef4444;
  }
  .pg-fb {
    margin-top: 0.9rem;
    font-weight: 700;
  }
  .pg-fb.ok {
    color: #16a34a;
  }
  .pg-fb.bad {
    color: #ef4444;
  }
  .pg-exp {
    border-left: 3px solid var(--accent);
    padding: 0.4rem 0.8rem;
    margin: 0.6rem 0;
    color: var(--muted-foreground);
    font-size: 0.88rem;
    line-height: 1.8;
  }
  .pg-facts {
    display: flex;
    gap: 0.6rem;
    margin-top: 1rem;
  }
  .pg-facts .pg-btn {
    flex: 1;
    padding: 0.55rem;
  }
  .pg-card {
    min-height: 15rem;
    display: flex;
    flex-direction: column;
    cursor: pointer;
  }
  .pg-card .atext {
    margin-top: 0.9rem;
    padding-top: 0.9rem;
    border-top: 1px dashed var(--border);
    font-size: 0.92rem;
    line-height: 1.9;
  }
  .pg-card.hidden-a .atext {
    filter: blur(6px);
    user-select: none;
    pointer-events: none;
  }
  .pg-exbar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.8rem;
    flex-wrap: wrap;
  }
  .pg-timer {
    font-variant-numeric: tabular-nums;
    background: var(--accent);
    color: var(--accent-foreground);
    border-radius: 99px;
    padding: 0.2rem 0.9rem;
    font-weight: 700;
  }
  .pg-timer.low {
    background: #ef4444;
  }
  .pg-dots {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(2.2rem, 1fr));
    gap: 0.35rem;
    margin-bottom: 0.8rem;
  }
  .pg-dot {
    border: 1px solid var(--border);
    border-radius: 6px;
    text-align: center;
    padding: 0.3rem 0;
    font-size: 0.75rem;
    cursor: pointer;
    color: var(--muted-foreground);
  }
  .pg-dot.answered {
    background: color-mix(in srgb, var(--accent) 12%, var(--background));
    border-color: var(--accent);
    color: var(--accent);
    font-weight: 700;
  }
  .pg-dot.cur {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .pg-score {
    font-size: 2.4rem;
    font-weight: 800;
    color: var(--accent);
  }
  .pg-res {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.7rem 1rem;
    margin: 0.5rem 0;
    font-size: 0.88rem;
    line-height: 1.85;
  }
  .pg-res.bad {
    border-color: color-mix(in srgb, #ef4444 45%, var(--border));
  }
  .pg-weak {
    border: 1px solid color-mix(in srgb, #d97706 40%, var(--border));
    background: color-mix(in srgb, #d97706 7%, var(--background));
    border-radius: 8px;
    padding: 0.65rem 1rem;
    font-size: 0.86rem;
    display: flex;
    gap: 0.75rem;
    align-items: center;
    flex-wrap: wrap;
    margin: 0.9rem 0;
  }
  .pg-overlay {
    position: fixed;
    inset: 0;
    background: rgb(15 23 42 / 0.55);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 99;
  }
  .pg-overlay .box {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.25rem;
    width: min(560px, 92vw);
  }
  .pg-overlay textarea {
    width: 100%;
    height: 11rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.6rem;
    font-size: 0.75rem;
    background: var(--background);
    color: var(--foreground);
  }
</style>

<script>
  const DATA: any = JSON.parse(
    document.getElementById("pg-data")!.textContent!.replace(/<\\\//g, "</")
  );
  const w = window as any;
  const $ = (s: string) => document.querySelector(s)!;
  const byUrl: Record<string, any> = {};
  DATA.files.forEach((f: any) => (byUrl[f.url] = f));
  const stageFiles: any[][] = [];
  DATA.files.forEach((f: any) => {
    (stageFiles[f.stage] = stageFiles[f.stage] || []).push(f);
  });

  let store: any;
  try {
    store = JSON.parse(localStorage.getItem("jvg1") || "{}");
  } catch (e) {
    store = {};
  }
  store.ck = store.ck || {};
  store.cards = store.cards || {};
  store.quiz = store.quiz || {};
  const save = () => {
    try {
      localStorage.setItem("jvg1", JSON.stringify(store));
    } catch (e) {}
  };

  const esc = (s: string) =>
    s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  function inline(s: string) {
    const codes: string[] = [];
    s = s.replace(/`([^`]+)`/g, (_m, c) => {
      codes.push(c);
      return "\u0000" + (codes.length - 1) + "\u0000";
    });
    const links: string[][] = [];
    s = s.replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, (_m, t, u) => {
      links.push([t, u]);
      return "\u0001" + (links.length - 1) + "\u0001";
    });
    s = s.replace(
      /https?:\/\/[A-Za-z0-9._~:/?#[\]@!$&'()*+,;=%-]+/g,
      m => `<a href="${m}" target="_blank" rel="noopener">${m}</a>`
    );
    s = s.replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>");
    s = s.replace(
      /\u0001(\d+)\u0001/g,
      (_m, i) => {
        const [t, u] = links[i];
        return `<a href="${u}">${t}</a>`;
      }
    );
    s = s.replace(/\u0000(\d+)\u0000/g, (_m, i) => `<code>${codes[i]}</code>`);
    return s;
  }
  const QNORM = (s: any) =>
    String(s).trim().toLowerCase().replace(/\s+/g, "");
  function shuffledArr(arr: any[]) {
    const a = arr.slice();
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }
  const fmtMs = (ms: number) => {
    const t = Math.max(0, Math.floor(ms / 1000));
    return Math.floor(t / 60) + ":" + String(t % 60).padStart(2, "0");
  };

  /* ---- 进度 ---- */
  const ckOf = (f: any) => {
    let st: any = {};
    try {
      st = JSON.parse(localStorage.getItem("jvg-ck:" + f.url) || "{}");
    } catch (e) {}
    return Object.keys(st).length;
  };
  const statsOf = (files: any[]) => {
    let total = 0, done = 0;
    files.forEach(f => {
      total += f.ck;
      done += Math.min(ckOf(f), f.ck);
    });
    let q = 0, qw = 0;
    DATA.quiz.forEach((x: any) => {
      const s = store.quiz[x.id];
      if (s) { q += s.r || 0; qw += s.w || 0; }
    });
    return { total, done, q, qw };
  };
  const overall = () => statsOf(DATA.files);

  /* ---- 路由 ---- */
  let cur = "home";
  function switchTo(t: string) {
    cur = ["home", "cards", "quiz", "exam"].includes(t) ? t : "home";
    document.querySelectorAll("#pg-tabs a").forEach(a =>
      a.classList.toggle("active", (a as HTMLElement).dataset.tab === cur)
    );
    if (cur === "home") renderHome();
    else if (cur === "cards") renderCards();
    else if (cur === "quiz") renderQuiz();
    else renderExam();
  }
  function route() {
    switchTo((location.hash || "#home").slice(1));
  }
  // 主题的 ClientRouter 会接管 hash 链接（pushState 不触发 hashchange），
  // 因此 tab 与页内跳转都显式走 switchTo。
  document.querySelectorAll("#pg-tabs a").forEach(a => {
    a.addEventListener("click", e => {
      e.preventDefault();
      const t = (a as HTMLElement).dataset.tab || "home";
      if (location.hash !== "#" + t) history.replaceState(null, "", "#" + t);
      switchTo(t);
    });
  });
  window.addEventListener("hashchange", route);
  w.__pgGo = (t: string) => {
    if (location.hash !== "#" + t) history.replaceState(null, "", "#" + t);
    switchTo(t);
  };

  /* ---- 进度总览 ---- */
  function renderHome() {
    const o = overall();
    const pct = o.total ? Math.round((o.done / o.total) * 100) : 0;
    const catStats: Record<string, any> = {};
    DATA.quiz.forEach((q: any) => {
      const st = store.quiz[q.id];
      if (!st) return;
      const c = catStats[q.cat] || (catStats[q.cat] = { r: 0, w: 0 });
      c.r += st.r || 0;
      c.w += st.w || 0;
    });
    const weak = Object.entries(catStats)
      .filter(([, v]: any) => v.r + v.w >= 3)
      .sort((a: any, b: any) => a[1].r / (a[1].r + a[1].w) - b[1].r / (b[1].r + b[1].w))[0];
    const known = Object.values(store.cards).filter((v: any) => v === "known").length;
    let rows = "";
    DATA.stages.forEach((name: string, si: number) => {
      const s = statsOf(stageFiles[si] || []);
      const p = s.total ? Math.round((s.done / s.total) * 100) : 0;
      rows += `<div class="pg-row"><span class="pg-name">${esc(name)}</span>`
        + `<span class="pg-bar"><i style="width:${p}%"></i></span>`
        + `<span class="pg-num">${s.done}/${s.total} · ${p}%</span></div>`;
    });
    $("#pg-view").innerHTML = `
      <div class="pg-panel">
        <div class="pg-row"><span class="pg-name">总进度</span>
        <span class="pg-bar"><i style="width:${pct}%"></i></span>
        <span class="pg-num">${o.done} / ${o.total}（${pct}%）</span></div>
        ${rows}
        <div class="pg-muted" style="margin-top:0.6rem">累计答题：答对 ${o.q} 次 · 答错 ${o.qw} 次 · 闪卡已掌握 ${known} / ${DATA.cards.length}</div>
      </div>
      ${weak ? `<div class="pg-weak"><span>薄弱环节：<b>${esc(weak[0])}</b>　正确率 ${Math.round((weak[1].r / (weak[1].r + weak[1].w)) * 100)}%（答对 ${weak[1].r} / 答错 ${weak[1].w}）</span>
        <span style="flex:1"></span><button class="pg-btn pg-primary" onclick="window.__pgCat='${esc(weak[0])}';window.__pgGo('quiz')">去针对性练习</button></div>` : ""}
      <div class="pg-panel">
        <div class="pg-muted">建议节奏：每章学完 →「选择填空」里选本章做小考（正确率 90%+ 过）；周末做一次「综合大考」（85% 为过关线）；每天用「闪卡」过八股。文章里的打卡勾选会自动计入总进度。</div>
      </div>`;
  }

  /* ---- 闪卡 ---- */
  let cardSession: any = null;
  function renderCards() {
    const cats = [...new Set(DATA.cards.map((c: any) => c.cat))];
    if (!cardSession)
      cardSession = { cat: "all", onlyReview: false, shuffled: false, i: 0, revealed: false, order: [], sig: null };
    const s = cardSession;
    const pool = DATA.cards.filter((c: any) =>
      (s.cat === "all" || c.cat === s.cat) &&
      (!s.onlyReview || store.cards[c.id] !== "known"));
    const sig = [s.cat, s.onlyReview, s.shuffled].join("|");
    if (s.sig !== sig) {
      s.sig = sig;
      s.order = s.shuffled ? shuffledArr(pool) : pool;
      s.i = Math.min(s.i, Math.max(0, s.order.length - 1));
    }
    const card = s.order[s.i];
    const known = Object.values(store.cards).filter((v: any) => v === "known").length;
    const chips = `<div class="pg-chips"><span class="pg-chip ${s.cat === "all" ? "on" : ""}" onclick="window.__pgCards({cat:'all'})">全部</span>`
      + cats.map((c: any) => `<span class="pg-chip ${s.cat === c ? "on" : ""}" onclick="window.__pgCards({cat:'${esc(String(c))}'})">${esc(String(c))}</span>`).join("")
      + `<span class="pg-chip ${s.shuffled ? "on" : ""}" onclick="window.__pgCards({shuffled:!cardSession.shuffled})">乱序</span>`
      + `<span class="pg-chip ${s.onlyReview ? "on" : ""}" style="margin-left:auto" onclick="window.__pgCards({onlyReview:!cardSession.onlyReview})">只看未掌握</span></div>`;
    let body: string;
    if (!card) {
      body = `<div class="pg-panel pg-card" style="align-items:center;justify-content:center"><div class="pg-q">这个筛选下没有卡片</div><div class="pg-muted">换个板块或关闭「只看未掌握」</div></div>`;
    } else {
      body = `<div class="pg-panel pg-card ${s.revealed ? "" : "hidden-a"}" onclick="window.__pgFlip()">
        <div class="pg-muted">${esc(card.cat)} · 第 ${s.i + 1} / ${s.order.length} 题</div>
        <div class="pg-q">Q：${esc(card.q)}</div>
        <div class="atext">${inline(esc(card.a))}</div>
        ${s.revealed && card.ref ? `<div class="pg-muted" style="margin-top:0.6rem">详见 <a href="${esc(card.ref)}">${esc(card.refTitle || "原文")}</a></div>` : ""}
        <div class="pg-muted" style="margin-top:0.6rem">${s.revealed ? "自评：真的掌握了再点「会了」" : "点击卡片显示答案（空格键）"}</div></div>
      <div class="pg-facts">
        <button class="pg-btn pg-primary" onclick="window.__pgGrade('known')">会了（1）</button>
        <button class="pg-btn" onclick="window.__pgGrade('review')">再看看（2）</button>
        <button class="pg-btn" onclick="window.__pgSkip()">跳过</button></div>`;
    }
    $("#pg-view").innerHTML = chips + body
      + `<div class="pg-muted" style="margin-top:0.8rem">已掌握 ${known} / ${DATA.cards.length}</div>`;
  }
  w.__pgCards = (patch: any) => {
    Object.assign(cardSession, patch, { i: 0, revealed: false });
    renderCards();
  };
  w.__pgFlip = () => { cardSession.revealed = !cardSession.revealed; renderCards(); };
  w.__pgSkip = () => { cardSession.i = Math.min(cardSession.i + 1, cardSession.order.length - 1); cardSession.revealed = false; renderCards(); };
  w.__pgGrade = (v: string) => {
    const card = cardSession.order[cardSession.i];
    if (card) { store.cards[card.id] = v; save(); }
    w.__pgSkip();
  };

  /* ---- 选择填空 ---- */
  let quizSession: any = null;
  function renderQuiz() {
    const qs = DATA.quiz;
    if (!quizSession)
      quizSession = { cat: "all", kind: "all", file: "all", onlyWrong: false, shuffled: false, i: 0, pool: [], revealed: false, sel: -1, vals: [], round: { done: 0, right: 0 } };
    const s = quizSession;
    if ((window as any).__pgCat) { s.cat = (window as any).__pgCat; (window as any).__pgCat = null; s.sig = null; }
    const pool = qs.filter((q: any) =>
      (s.cat === "all" || q.cat === s.cat) &&
      (s.kind === "all" || q.kind === s.kind) &&
      (s.file === "all" || q.ref === s.file) &&
      (!s.onlyWrong || (store.quiz[q.id] || {}).last === "wrong"));
    const sig = [s.cat, s.kind, s.file, s.onlyWrong, s.shuffled].join("|");
    if (s.sig !== sig || !s.pool) {
      s.sig = sig;
      s.pool = s.shuffled ? shuffledArr(pool) : pool;
      s.i = 0; s.revealed = false; s.sel = -1; s.vals = [];
      s.round = { done: 0, right: 0 };
    }
    const cats = [...new Set(qs.map((q: any) => q.cat))];
    const totalRight = qs.reduce((n: number, q: any) => n + ((store.quiz[q.id] || {}).r || 0), 0);
    const totalWrong = qs.reduce((n: number, q: any) => n + ((store.quiz[q.id] || {}).w || 0), 0);
    const chapMap: Record<string, number> = {};
    qs.forEach((q: any) => { if (q.ref) chapMap[q.ref] = (chapMap[q.ref] || 0) + 1; });
    const chapSel = `<div class="pg-chips"><span class="pg-muted" style="align-self:center">章节小考：</span>
      <select class="pg-select" onchange="w.__pgCards2({file:this.value})">
      <option value="all"${s.file === "all" ? " selected" : ""}>全部章节（${qs.length} 题）</option>
      ${Object.keys(chapMap).map(u => `<option value="${u}"${s.file === u ? " selected" : ""}>${esc(byUrl[u] ? byUrl[u].title : u)}（${chapMap[u]} 题）</option>`).join("")}
      </select><span class="pg-muted" style="align-self:center">选一章 = 本章小考，建议配乱序</span></div>`;
    const chips = `<div class="pg-chips">
      <span class="pg-chip ${s.kind === "all" ? "on" : ""}" onclick="window.__pgCards2({kind:'all'})">全部题型</span>
      <span class="pg-chip ${s.kind === "select" ? "on" : ""}" onclick="window.__pgCards2({kind:'select'})">仅选择题</span>
      <span class="pg-chip ${s.kind === "blank" ? "on" : ""}" onclick="window.__pgCards2({kind:'blank'})">仅填空题</span>
      <span class="pg-chip ${s.shuffled ? "on" : ""}" onclick="window.__pgCards2({shuffled:!quizSession.shuffled})">乱序</span>
      <span class="pg-chip ${s.onlyWrong ? "on" : ""}" style="margin-left:auto" onclick="window.__pgCards2({onlyWrong:!quizSession.onlyWrong})">只做错题</span></div>
      <div class="pg-chips"><span class="pg-chip ${s.cat === "all" ? "on" : ""}" onclick="window.__pgCards2({cat:'all'})">全部板块</span>
      ${cats.map((c: any) => `<span class="pg-chip ${s.cat === c ? "on" : ""}" onclick="window.__pgCards2({cat:'${esc(String(c))}'})">${esc(String(c))}</span>`).join("")}</div>`;
    let body: string;
    if (s.i >= s.pool.length) {
      body = `<div class="pg-panel" style="text-align:center"><div class="pg-score">本轮完成</div>
        <div class="pg-muted">${s.round.done} 题答对 ${s.round.right} 题 · 错题已记录，可用「只做错题」重练</div>
        <div class="pg-facts" style="justify-content:center"><button class="pg-btn pg-primary" onclick="window.__pgQuizRestart()">再来一轮</button></div></div>`;
    } else {
      const q = s.pool[s.i];
      const head = `<div class="pg-muted" style="margin-bottom:0.5rem">${esc(q.cat)} · ${esc(q.diff)} · 第 ${s.i + 1} / ${s.pool.length} 题（本轮答对 ${s.round.right}/${s.round.done}）</div>`;
      if (q.kind === "select") {
        const aIdx = "ABCD".indexOf(q.a);
        body = `<div class="pg-panel">${head}<div class="pg-q">${inline(esc(q.q))}</div><div style="margin-top:0.9rem">`
          + q.opts.map((o: string, k: number) => {
            let cls = "pg-opt";
            if (s.revealed) { if (k === aIdx) cls += " right"; else if (k === s.sel) cls += " wrong"; }
            return `<div class="${cls}" onclick="window.__pgPick(${k})"><b>${"ABCD"[k]}</b><span>${inline(esc(o))}</span></div>`;
          }).join("") + `</div>`
          + (s.revealed ? pgFeedback(q, s.sel === aIdx, "正确答案：" + q.a) : `<div class="pg-muted" style="margin-top:0.7rem">点击选项作答（可按 1~4 键），答完立即判分</div>`) + `</div>`;
      } else {
        const segs = q.q.split(/＿{2,}/);
        const stem = segs.map((seg: string, k: number) => inline(esc(seg))
          + (k < segs.length - 1 ? `<input class="pg-blank${s.revealed ? (s.blankOk[k] ? " ok" : " bad") : ""}" data-k="${k}" value="${esc(s.vals[k] || "")}"${s.revealed ? " disabled" : ""} placeholder="填空${k + 1}">` : "")).join("");
        const ansTxt = "正确答案：" + q.alts.map((a: string[]) => a.join("／")).join("；");
        body = `<div class="pg-panel">${head}<div class="pg-q" style="line-height:2.3">${stem}</div>`
          + (s.revealed ? pgFeedback(q, s.blankOk.every(Boolean), ansTxt)
            : `<div class="pg-facts" style="margin-top:1rem"><button class="pg-btn pg-primary" onclick="window.__pgSubmitBlanks()">提交答案</button></div><div class="pg-muted" style="margin-top:0.4rem">回车键也可提交</div>`) + `</div>`;
      }
    }
    $("#pg-view").innerHTML = `<div class="pg-muted" style="margin:0.4rem 0">共 ${qs.length} 题 · 累计答对 <b>${totalRight}</b> 次 · 答错 <b>${totalWrong}</b> 次　<button class="pg-btn" style="font-size:0.72rem;padding:0.15rem 0.55rem" onclick="window.__pgExportWrong()">导出错题</button></div>`
      + chapSel + chips + body;
    const inp = document.querySelector(".pg-blank:not([disabled])") as HTMLInputElement | null;
    if (inp && !quizSession.revealed) inp.focus();
  }
  function pgFeedback(q: any, ok: boolean, ansTxt: string) {
    return `<div class="pg-fb ${ok ? "ok" : "bad"}">${ok ? "回答正确" : "回答错误　" + esc(ansTxt)}</div>`
      + `<div class="pg-exp">${inline(esc(q.exp))}</div>`
      + (q.ref ? `<div class="pg-muted" style="margin-top:0.3rem">详见 <a href="${esc(q.ref)}">${esc(q.refTitle || "原文")}</a></div>` : "")
      + `<div class="pg-facts"><button class="pg-btn pg-primary" onclick="window.__pgNext()">${quizSession.i + 1 >= quizSession.pool.length ? "查看本轮成绩" : "下一题"}</button></div>`;
  }
  w.__pgCards2 = (patch: any) => {
    Object.assign(quizSession, patch, { i: 0, revealed: false, sel: -1, vals: [], round: { done: 0, right: 0 } });
    renderQuiz();
  };
  w.__pgQuizRestart = () => { Object.assign(quizSession, { i: 0, revealed: false, sel: -1, vals: [], round: { done: 0, right: 0 } }); renderQuiz(); };
  w.__pgNext = () => { quizSession.i++; quizSession.revealed = false; quizSession.sel = -1; quizSession.vals = []; renderQuiz(); };
  function recordQuiz(q: any, ok: boolean) {
    const st = store.quiz[q.id] || (store.quiz[q.id] = { r: 0, w: 0 });
    ok ? st.r++ : st.w++;
    st.last = ok ? "right" : "wrong";
    if (quizSession) { quizSession.round.done++; if (ok) quizSession.round.right++; }
    save();
  }
  w.__pgPick = (k: number) => {
    const s = quizSession, q = s.pool[s.i];
    if (!q || s.revealed || q.kind !== "select") return;
    s.sel = k; s.revealed = true;
    recordQuiz(q, k === "ABCD".indexOf(q.a));
    renderQuiz();
  };
  w.__pgSubmitBlanks = () => {
    const s = quizSession, q = s.pool[s.i];
    if (!q || s.revealed || q.kind !== "blank") return;
    const n = q.q.split(/＿{2,}/).length - 1;
    const inputs = document.querySelectorAll(".pg-blank");
    s.vals = []; s.blankOk = [];
    for (let k = 0; k < n; k++) {
      const v = (inputs[k] as HTMLInputElement)?.value || "";
      s.vals.push(v);
      s.blankOk.push((q.alts[k] || []).some((a: string) => QNORM(a) === QNORM(v)));
    }
    s.revealed = true;
    recordQuiz(q, s.blankOk.every(Boolean));
    renderQuiz();
  };
  w.__pgExportWrong = () => {
    const wrong = DATA.quiz.filter((q: any) => (store.quiz[q.id] || {}).last === "wrong");
    if (!wrong.length) { alert("当前错题池是空的，太棒了！"); return; }
    let md = "# 错题本（" + new Date().toLocaleDateString() + "，共 " + wrong.length + " 题）\n\n";
    wrong.forEach((q: any) => {
      md += "## [" + q.cat + "·" + q.diff + "] " + q.q + "\n";
      if (q.kind === "select") { q.opts.forEach((o: string, k: number) => md += "- " + "ABCD"[k] + ". " + o + "\n"); md += "\n正确答案：" + q.a + "\n"; }
      else md += "\n正确答案：" + q.alts.map((a: string[]) => a.join("／")).join("；") + "\n";
      md += "解析：" + q.exp.replace(/\[《([^》]+)》\]\([^)]+\)/g, "《$1》") + "\n\n";
    });
    const show = (t: string) => {
      const ov = document.getElementById("pg-overlay")!;
      (ov.querySelector("h3") as HTMLElement).textContent = "错题导出（" + wrong.length + " 题，" + t + "）";
      (ov.querySelector("textarea") as HTMLTextAreaElement).value = md;
      ov.style.display = "flex";
    };
    if (navigator.clipboard && navigator.clipboard.writeText)
      navigator.clipboard.writeText(md).then(() => show("已复制到剪贴板")).catch(() => show("请手动复制"));
    else show("请手动复制");
  };

  /* ---- 综合大考 ---- */
  let examSession: any = null, examTimer: any = null;
  function renderExam() {
    const s = examSession;
    if (!s) {
      $("#pg-view").innerHTML = `<div class="pg-panel" style="text-align:center">
        <div class="pg-q" style="margin-bottom:0.4rem">从全部 ${DATA.quiz.length} 题中随机抽题、统一计时，交卷后出分并逐题解析</div>
        <div class="pg-muted">成绩计入错题本与「薄弱环节」。建议大部分内容学完后再来。</div>
        <div class="pg-chips" style="justify-content:center;margin-top:1rem">
        ${[10, 20, 40].map(n => `<span class="pg-chip" style="padding:0.4rem 1rem" onclick="window.__pgStartExam(${n})">${n} 题 · ${n} 分钟</span>`).join("")}</div>
        <div class="pg-muted" style="margin-top:0.6rem">快捷键：数字键 1~4 选答案 · 左右方向键切题 · E 交卷</div></div>`;
      return;
    }
    if (s.phase === "run") {
      const q = s.order[s.i];
      const answeredN = s.order.filter((x: any) => {
        const a = s.answers[x.id];
        return a !== undefined && a !== null && !(Array.isArray(a) && a.every((v: string) => !v));
      }).length;
      const dots = s.order.map((x: any, k: number) => {
        const a = s.answers[x.id];
        const has = a !== undefined && a !== null && !(Array.isArray(a) && a.every((v: string) => !v));
        return `<div class="pg-dot${has ? " answered" : ""}${k === s.i ? " cur" : ""}" onclick="window.__pgExamGo(${k})">${k + 1}</div>`;
      }).join("");
      let body: string;
      if (q.kind === "select") {
        const sel = s.answers[q.id];
        body = `<div class="pg-q">${inline(esc(q.q))}</div><div style="margin-top:0.9rem">`
          + q.opts.map((o: string, k: number) =>
            `<div class="pg-opt${sel === "ABCD"[k] ? " right" : ""}" onclick="window.__pgExamPick(${k})"><b>${"ABCD"[k]}</b><span>${inline(esc(o))}</span></div>`).join("") + `</div>`;
      } else {
        const segs = q.q.split(/＿{2,}/);
        const cur = s.answers[q.id] || [];
        body = `<div class="pg-q" style="line-height:2.3">${segs.map((seg: string, k: number) => inline(esc(seg))
          + (k < segs.length - 1 ? `<input class="pg-blank" data-k="${k}" value="${esc(cur[k] || "")}" oninput="w.__pgExamBlank(this)" placeholder="填空${k + 1}">` : "")).join("")}</div>
          <div class="pg-muted" style="margin-top:0.5rem">作答自动保存，切题不丢失</div>`;
      }
      $("#pg-view").innerHTML = `<div class="pg-exbar">
        <span class="pg-timer" id="pg-timer">${fmtMs(s.deadline - Date.now())}</span>
        <span class="pg-muted">第 ${s.i + 1} / ${s.order.length} 题 · 已答 ${answeredN}</span><span style="flex:1"></span>
        <button class="pg-btn pg-primary" onclick="window.__pgSubmitExam()">交卷</button>
        <button class="pg-btn" onclick="window.__pgExamQuit()">放弃</button></div>
        <div class="pg-dots">${dots}</div>
        <div class="pg-panel"><div class="pg-muted" style="margin-bottom:0.4rem">${esc(q.cat)} · ${esc(q.diff)}</div>${body}</div>
        <div class="pg-facts"><button class="pg-btn" onclick="window.__pgExamGo(${s.i - 1})"${s.i === 0 ? " disabled" : ""}>← 上一题</button>
        <button class="pg-btn pg-primary" onclick="window.__pgExamGo(${s.i + 1})"${s.i === s.order.length - 1 ? " disabled" : ""}>下一题 →</button></div>`;
      return;
    }
    const right = s.order.filter((q: any) => s.result[q.id]).length;
    const list = s.order.map((q: any, k: number) => {
      const ok = s.result[q.id];
      return `<div class="pg-res${ok ? "" : " bad"}"><b>${ok ? "✓" : "✗"} 第 ${k + 1} 题（${esc(q.cat)}·${esc(q.diff)}）</b>
        <div style="margin:0.25rem 0">${inline(esc(q.q))}</div>
        ${q.kind === "select"
          ? `<div class="pg-muted">你的答案：${esc(String(s.answers[q.id] || "未作答"))} · 正确答案：${esc(q.a)}</div>`
          : `<div class="pg-muted">正确答案：${esc(q.alts.map((a: string[]) => a.join("／")).join("；"))}</div>`}
        <div class="pg-exp">${inline(esc(q.exp))}</div>
        ${q.ref ? `<div class="pg-muted">详见 <a href="${esc(q.ref)}">${esc(q.refTitle || "原文")}</a></div>` : ""}</div>`;
    }).join("");
    $("#pg-view").innerHTML = `<div class="pg-panel" style="text-align:center">
      <div class="pg-score">${right} / ${s.order.length}</div>
      <div class="pg-muted">正确率 ${Math.round((right / s.order.length) * 100)}% · 用时 ${fmtMs(s.usedMs)} · ${right / s.order.length >= 0.85 ? "达到 85% 过关线，继续保持" : "未到 85% 过关线：用「只做错题」补漏后再来"}</div>
      <div class="pg-facts" style="justify-content:center"><button class="pg-btn pg-primary" onclick="examSession=null;renderExam()">再来一套</button></div></div>
      <div style="margin-top:0.9rem">${list}</div>`;
  }
  w.__pgStartExam = (n: number) => {
    if (examTimer) clearInterval(examTimer);
    const order = shuffledArr(DATA.quiz.slice()).slice(0, Math.min(n, DATA.quiz.length));
    examSession = { phase: "run", order, i: 0, answers: {}, result: {}, deadline: Date.now() + order.length * 60000, startTs: Date.now(), usedMs: 0 };
    examTimer = setInterval(examTick, 500);
    renderExam();
  };
  function examTick() {
    const s = examSession;
    if (!s || s.phase !== "run") return;
    const el = document.getElementById("pg-timer");
    if (el) {
      const left = s.deadline - Date.now();
      el.textContent = fmtMs(left);
      el.classList.toggle("low", left < 60000);
    }
    if (Date.now() >= s.deadline) submitExam(true);
  }
  w.__pgExamGo = (k: number) => {
    const s = examSession;
    if (!s || k < 0 || k >= s.order.length) return;
    s.i = k; renderExam();
  };
  w.__pgExamPick = (k: number) => {
    const s = examSession, q = s.order[s.i];
    if (q.kind !== "select") return;
    s.answers[q.id] = "ABCD"[k];
    renderExam();
  };
  w.__pgExamBlank = (inp: HTMLInputElement) => {
    const s = examSession, q = s.order[s.i];
    const k = +inp.dataset.k!;
    const cur = s.answers[q.id] || [];
    cur[k] = inp.value;
    s.answers[q.id] = cur;
  };
  w.__pgExamQuit = () => {
    if (confirm("放弃本次大考？作答将不计入记录。")) {
      if (examTimer) clearInterval(examTimer);
      examSession = null; renderExam();
    }
  };
  function submitExam(auto?: boolean) {
    const s = examSession;
    if (!s || s.phase !== "run") return;
    if (!auto && !confirm("确认交卷？未作答的题按错误计。")) return;
    if (examTimer) clearInterval(examTimer);
    s.usedMs = Date.now() - s.startTs;
    s.phase = "done";
    s.order.forEach((q: any) => {
      let ok = false;
      if (q.kind === "select") {
        ok = s.answers[q.id] === q.a;
      } else {
        const n = q.q.split(/＿{2,}/).length - 1;
        const vals = s.answers[q.id] || [];
        ok = true;
        for (let k = 0; k < n; k++) {
          if (!(q.alts[k] || []).some((a: string) => QNORM(a) === QNORM(vals[k] || ""))) {
            ok = false;
            break;
          }
        }
      }
      s.result[q.id] = ok;
      recordQuiz(q, ok);
    });
    if (location.hash.includes("exam") || auto) renderExam();
  }
  w.__pgSubmitExam = () => submitExam();

  /* ---- 导入 / 导出 / 重置 ---- */
  const overlay = () => {
    const ov = document.createElement("div");
    ov.className = "pg-overlay"; ov.id = "pg-overlay";
    ov.innerHTML = `<div class="box"><h3 style="margin:0 0 0.6rem;font-size:0.95rem">进度</h3>
      <textarea></textarea>
      <div style="display:flex;gap:0.5rem;justify-content:flex-end;margin-top:0.6rem">
      <button class="pg-btn" onclick="this.closest('.pg-overlay').style.display='none'">关闭</button></div></div>`;
    document.body.appendChild(ov);
    return ov;
  };
  document.getElementById("pg-export")!.addEventListener("click", () => {
    const ov = overlay();
    (ov.querySelector("h3") as HTMLElement).textContent = "导出进度（复制保存）";
    (ov.querySelector("textarea") as HTMLTextAreaElement).value = JSON.stringify(store);
    ov.style.display = "flex";
  });
  document.getElementById("pg-import")!.addEventListener("click", () => {
    const ov = overlay();
    (ov.querySelector("h3") as HTMLElement).textContent = "导入进度（粘贴 JSON 后点关闭）";
    const ta = ov.querySelector("textarea") as HTMLTextAreaElement;
    ta.value = "";
    ta.addEventListener("change", () => {
      try {
        const s = JSON.parse(ta.value);
        if (typeof s !== "object") throw 0;
        store = s;
        store.ck = store.ck || {}; store.cards = store.cards || {}; store.quiz = store.quiz || {};
        save();
        route();
      } catch (e) { alert("JSON 解析失败"); }
    });
    ov.style.display = "flex";
  });
  document.getElementById("pg-reset")!.addEventListener("click", () => {
    if (confirm("确定清空所有练习进度？（文章打卡不受影响）")) {
      store = { ck: {}, cards: {}, quiz: {} };
      save();
      cardSession = null; quizSession = null; examSession = null;
      route();
    }
  });

  /* ---- 键盘 ---- */
  document.addEventListener("keydown", e => {
    const tg = document.activeElement ? document.activeElement.tagName : "";
    if (tg === "INPUT" || tg === "TEXTAREA") return;
    if (cur === "cards" && cardSession && cardSession.order.length) {
      if (e.key === " ") { e.preventDefault(); w.__pgFlip(); }
      else if (e.key === "1" && cardSession.revealed) w.__pgGrade("known");
      else if (e.key === "2" && cardSession.revealed) w.__pgGrade("review");
    } else if (cur === "quiz" && quizSession && quizSession.pool && quizSession.i < quizSession.pool.length) {
      const q = quizSession.pool[quizSession.i];
      if (!quizSession.revealed && q.kind === "select" && /^[1-4]$/.test(e.key)) { e.preventDefault(); w.__pgPick(+e.key - 1); }
      else if (quizSession.revealed && (e.key === "Enter" || e.key === " ")) { e.preventDefault(); w.__pgNext(); }
    } else if (cur === "exam" && examSession && examSession.phase === "run") {
      const q = examSession.order[examSession.i];
      if (q.kind === "select" && /^[1-4]$/.test(e.key)) { e.preventDefault(); w.__pgExamPick(+e.key - 1); }
      else if (e.key === "ArrowRight") { e.preventDefault(); w.__pgExamGo(examSession.i + 1); }
      else if (e.key === "ArrowLeft") { e.preventDefault(); w.__pgExamGo(examSession.i - 1); }
      else if (e.key === "e" || e.key === "E") { e.preventDefault(); submitExam(); }
    }
  });

  route();
</script>
